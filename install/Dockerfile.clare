# Minimal Dockerfile for running CLARE verification steps in isolation
# Base: Node (includes npm), add Python and common CLI tools used by verify scripts

FROM node:18-bullseye

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 python3-pip git curl ca-certificates gnupg lsb-release \
      jq ripgrep wget unzip build-essential procps \
    && rm -rf /var/lib/apt/lists/*

# Install yq (mikefarah) and make available. Architecture is derived from the
# build platform; dpkg's amd64/arm64 names match mikefarah's release suffixes.
RUN YQ_VERSION=v4.41.1 && \
    yqarch="$(dpkg --print-architecture)" && \
    curl -L -o /usr/local/bin/yq "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${yqarch}" && \
    chmod +x /usr/local/bin/yq

# Install Go from official tarball (optional - override GO_VERSION at build time)
ARG GO_VERSION=1.22.9
# SHFMT_VERSION is pinned (not @latest) so a future shfmt release that raises its
# required Go version can't silently break this image's build.
ARG SHFMT_VERSION=v3.10.0
RUN set -eux; \
    if [ -n "${GO_VERSION:-}" ]; then \
      echo "Installing Go ${GO_VERSION}"; \
      goarch="$(dpkg --print-architecture)"; \
      curl -fsSL -o /tmp/go.tar.gz "https://go.dev/dl/go${GO_VERSION}.linux-${goarch}.tar.gz"; \
      rm -rf /usr/local/go; \
      tar -C /usr/local -xzf /tmp/go.tar.gz; \
      rm -f /tmp/go.tar.gz; \
    else \
      echo 'GO_VERSION not set; skipping Go install'; \
    fi

# Ensure Go binaries are in PATH and installs via `go install` land in /usr/local/bin
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOBIN=/usr/local/bin

# Install shfmt via `go install` if Go is available; otherwise skip. When Go IS
# present the install must succeed — failing loudly here surfaces a broken pin or
# a Go-version mismatch instead of silently shipping an image without shfmt.
RUN if command -v go >/dev/null 2>&1; then \
      go install "mvdan.cc/sh/v3/cmd/shfmt@${SHFMT_VERSION}"; \
    else \
      echo 'go not found; skipping shfmt install via go'; \
    fi

# Optional Python tools that are commonly used by CLARE verification
RUN python3 -m pip install --no-cache-dir pyyaml || true

# Create a non-root user for safety (optional)
RUN useradd -m --uid 1000 claresh
USER claresh
WORKDIR /work

# Entrypoint: run verify-ci.sh if present in mounted project
ENTRYPOINT ["/bin/bash", "-lc", "if [ -f ./clare/verify-ci.sh ]; then bash ./clare/verify-ci.sh --fast; else echo 'No clare/verify-ci.sh found'; fi"]
